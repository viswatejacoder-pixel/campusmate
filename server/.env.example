# CampusMate environment variables (TEMPLATE - safe to commit).
# Copy this file to ".env" and fill in real values. NEVER commit ".env".

# --- Application ---
NODE_ENV=development
PORT=3000

# --- MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=campusmate
DB_USER=campusmate_app
DB_PASSWORD=change_me_to_your_local_db_password

# --- Sessions ---
# Generate a value with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_with_a_long_random_string_at_least_32_chars
# How long a login session lasts, in hours.
SESSION_MAX_AGE_HOURS=8

# --- Email verification (T-075) ---
# console = development only: prints the verification link to the server console. Not allowed when NODE_ENV=production.
# brevo   = real email through the Brevo HTTPS API (needs the three values below).
MAIL_TRANSPORT=
# Base URL of the client used in the emailed link, no path, e.g. http://localhost:5173
APP_BASE_URL=
# Required only for brevo. MAIL_FROM_EMAIL must be a sender verified in Brevo.
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=
BREVO_API_KEY=
# Test servers only (ignored when NODE_ENV=production): true switches rate limiting off.
RATE_LIMIT_DISABLED=
